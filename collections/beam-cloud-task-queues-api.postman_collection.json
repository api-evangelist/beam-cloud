          "id": "030c8ef1-dfa8-44bc-989d-a81bb58ebd0d",
          "name": "Submit an asynchronous task to a deployed task queue",
          "request": {
            "name": "Submit an asynchronous task to a deployed task queue",
            "description": {
              "content": "Enqueue an asynchronous task on a deployed TaskQueue, addressed by its name on the shared invocation host (a deployment is equivalently reachable at its app subdomain https://{name}-{id}.app.beam.cloud). The call returns immediately with a task_id; the result is retrieved later from the Tasks management API or delivered to a configured callback_url webhook. Use task queues for long-running work beyond the synchronous endpoint window.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "taskqueue",
                ":name"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "name",
                  "description": "(Required) The name of the deployed task queue."
                }
              ]
            },
