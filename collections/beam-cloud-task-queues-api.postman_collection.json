    "_postman_id": "18afac28-3a39-4635-ac7f-768365dc724d",
    "name": "Beam Task Queues API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Specification of the documented Beam (beam.cloud) HTTP surfaces: synchronous invocation of deployed web endpoints, asynchronous task submission to deployed task queues, and the control-plane Tasks API for querying status and cancelling tasks. Beam deployments are created from Python with the Beam SDK/CLI; this spec covers the resulting HTTP invocation and management patterns only.\n\nContact Support:\n Name: Beam Support",
      "type": "text/plain"
    }
